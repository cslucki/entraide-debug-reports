  - type: table
    name: Tout
    order:
      - file.name
      - file.ctime
      - statut
    sort:
      - property: statut
        direction: DESC
      - property: file.name
        direction: DESC
      - property: file.ctime
        direction: ASC
  - type: table
    name: A faire
    filters:
      and:
        - statut == "A faire"
    order:
      - file.name
      - file.ctime
      - file.folder
      - statut
    sort:
      - property: statut
        direction: ASC
      - property: file.ctime
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Fait
    filters:
      and:
        - statut == "Fait"
    order:
      - file.name
      - file.ctime
      - file.folder
      - statut
    sort:
      - property: statut
        direction: ASC
      - property: file.ctime
        direction: ASC
      - property: file.name
        direction: ASC
